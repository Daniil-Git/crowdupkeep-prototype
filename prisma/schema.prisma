// CrowdUpKeep — Prisma schema (SQLite)
//
// Note: SQLite does not support the native String[] scalar list type, so the
// "photos" / "proofPhotos" fields are persisted as Json. The application
// layer treats these as string arrays at all read/write boundaries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  xp       Int    @default(0)
  streak   Int    @default(0)
  location Json?
}

model Report {
  id         Int    @id @default(autoincrement())
  title      String
  geometry   Json
  status     String @default("pending")
  difficulty Int    @default(1)
  createdBy  Int
  photos     Json   @default("[]")
}

model Comment {
  id       Int    @id @default(autoincrement())
  text     String
  reportId Int
  parentId Int?
  authorId Int
}

model Solution {
  id          Int    @id @default(autoincrement())
  description String
  reportId    Int
  status      String @default("pending")
  proofPhotos Json   @default("[]")
}

model Voucher {
  id        Int    @id @default(autoincrement())
  code      String @unique
  value     Float
  claimedBy Int?
}
